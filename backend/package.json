{
  "name": "@place/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check:worker": "npm run build && node dist/entrypoints/worker/main.js --check",
    "check": "npm run typecheck && npm run test && npm run check:worker"
  },
  "dependencies": {
    "fastify": "5.12.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.0.0",
    "typescript": "5.7.3",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=22.6.0"
  }
}
