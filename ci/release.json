      "capabilities": ["docker-build"], "tool": "gotgotgan-image-builder",
      "command": ["python", "ci/build-images.py"], "timeout_seconds": 3600,
      "versions": ["python", "node", "npm", "docker"], "docker_resources": true,
      "artifacts": [
        {"name": "gotgotgan-web-image.tar", "kind": "docker-image"},
        {"name": "gotgotgan-admin-web-image.tar", "kind": "docker-image"},
        {"name": "gotgotgan-backend-image.tar", "kind": "docker-image"},
        {"name": "gotgotgan-image-verification.json", "kind": "file"}
      ]
    }
  ]
}
