{
  "schemaVersion": "place-application-runtime.v1",
  "deliveryState": "source-only",
  "publicProcess": "web",
  "artifactInputs": {
    "releaseRevisionEnvironment": "PLACE_RELEASE_REVISION",
    "imageEnvironments": {
      "web": "PLACE_WEB_IMAGE",
      "backend": "PLACE_BACKEND_IMAGE"
    },
    "deployedUnitEnvironments": {
      "releaseRevision": "PLACE_DEPLOYED_RELEASE_REVISION",
      "webImage": "PLACE_DEPLOYED_WEB_IMAGE",
      "backendImage": "PLACE_DEPLOYED_BACKEND_IMAGE"
    },
    "immutableDigestRequired": true
  },
  "processes": {
    "web": {
      "exposure": "gateway-candidate",
      "healthPath": "/healthz",
      "readinessPath": "/readyz",
      "configurationGroups": [
        "web-listener",
        "oidc-client",
        "membership-backend",
        "import-backend",
        "connector-backend"
      ],
      "secretFileRoles": [
        "database-url",
        "oidc-client-secret",
        "oidc-encryption-keyring"
      ]
    },
    "backend": {
      "exposure": "internal",
      "healthPath": "/healthz",
      "readinessPath": "/readyz",
      "configurationGroups": [
        "backend-listener",
        "oidc-resource-server",
        "membership-policy",
        "database-pool",
        "connector-receiver",
        "capture-artifact-store"
      ],
      "secretFileRoles": [
        "database-url",
        "capture-keyring"
      ]
    },
    "worker": {
      "exposure": "internal",
      "activation": "optional",
      "configurationGroups": [
        "worker-database-pool",
        "capture-artifact-store",
        "capture-retention-sweep"
      ],
      "secretFileRoles": [
        "database-url",
        "capture-keyring"
      ]
    }
  },
  "connections": {
    "browserToBackend": "forbidden",
    "webToBackend": "server-to-server",
    "crossProjectDatabase": "forbidden"
  },
  "rollback": {
    "unit": "place-application",
    "database": "preserve",
    "migration": "application-only"
  },
  "activationGates": [
    "immutable-artifact",
    "database-migration-and-restore",
    "identity-client-provisioning",
    "gateway-route-and-rollback",
    "public-browser-e2e"
  ]
}
