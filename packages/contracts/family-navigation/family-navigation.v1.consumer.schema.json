{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:place:family-navigation:v1:consumer",
  "title": "Family navigation consumer manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "deliveryState", "items"],
  "properties": {
    "contract": { "const": "family-navigation.v1" },
    "deliveryState": {
      "enum": ["active", "integration-gated", "source-only", "not-integrated"]
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["serviceId", "label", "href"],
        "properties": {
          "serviceId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" },
          "label": { "type": "string", "minLength": 1 },
          "href": { "type": "string", "pattern": "^https://" }
        }
      }
    }
  }
}
