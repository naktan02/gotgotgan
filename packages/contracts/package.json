{
  "name": "@place/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./catalog": {
      "types": "./dist/catalog/index.d.ts",
      "default": "./dist/catalog/index.js"
    },
    "./connector": {
      "types": "./dist/connector/index.d.ts",
      "default": "./dist/connector/index.js"
    },
    "./http": {
      "types": "./dist/http/index.d.ts",
      "default": "./dist/http/index.js"
    },
    "./imports": {
      "types": "./dist/imports/index.d.ts",
      "default": "./dist/imports/index.js"
    },
    "./library": {
      "types": "./dist/library/index.d.ts",
      "default": "./dist/library/index.js"
    },
    "./place-reference": {
      "types": "./dist/place-reference/index.d.ts",
      "default": "./dist/place-reference/index.js"
    },
    "./places": {
      "types": "./dist/places/index.d.ts",
      "default": "./dist/places/index.js"
    },
    "./profiles": {
      "types": "./dist/profiles/index.d.ts",
      "default": "./dist/profiles/index.js"
    },
    "./search": {
      "types": "./dist/search/index.d.ts",
      "default": "./dist/search/index.js"
    },
    "./transfers": {
      "types": "./dist/transfers/index.d.ts",
      "default": "./dist/transfers/index.js"
    },
    "./visits": {
      "types": "./dist/visits/index.d.ts",
      "default": "./dist/visits/index.js"
    },
    "./writing": {
      "types": "./dist/writing/index.d.ts",
      "default": "./dist/writing/index.js"
    }
  },
  "files": [
    "dist",
    "connector/place-connector.v1.schema.json",
    "http/openapi.v1.json",
    "place-reference/place-reference.v1.schema.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "generate": "npm run build && node scripts/generate-contracts.mjs",
    "test": "vitest run",
    "check": "npm run build && npm run test && node scripts/generate-contracts.mjs --check && node scripts/validate-contracts.mjs"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.0.0",
    "typescript": "5.7.3",
    "vitest": "4.1.11"
  }
}
