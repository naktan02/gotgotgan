{
  "openapi": "3.1.0",
  "info": {
    "title": "Place HTTP contract",
    "version": "1.0.0"
  },
  "paths": {
    "/healthz": {
      "get": {
        "operationId": "getPlaceHealth",
        "responses": {
          "200": {
            "description": "Process is alive"
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "operationId": "getPlaceReadiness",
        "responses": {
          "200": {
            "description": "Process can accept traffic"
          },
          "503": {
            "description": "One or more required process dependencies are unavailable"
          }
        }
      }
    },
    "/api/auth/oidc/start": {
      "get": {
        "operationId": "startPlaceBrowserLogin",
        "responses": {
          "302": {
            "description": "Redirect to the configured Identity authorization endpoint"
          },
          "503": {
            "$ref": "#/components/responses/BrowserAuthUnavailable"
          }
        }
      }
    },
    "/api/auth/oidc/callback": {
      "get": {
        "operationId": "completePlaceBrowserLogin",
        "responses": {
          "303": {
            "description": "Create an opaque browser session and redirect to the local post-login path"
          },
          "400": {
            "$ref": "#/components/responses/BrowserAuthRejected"
          },
          "503": {
            "$ref": "#/components/responses/BrowserAuthUnavailable"
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "operationId": "endPlaceBrowserSession",
        "responses": {
          "303": {
            "description": "Delete the server-side session, clear the opaque cookie, and redirect locally"
          },
          "503": {
            "$ref": "#/components/responses/BrowserAuthUnavailable"
          }
        }
      }
    },
    "/api/membership-consents/current": {
      "get": {
        "operationId": "getCurrentPlaceMembershipConsentsForBrowser",
        "security": [],
        "responses": {
          "200": {
            "description": "Return the server-selected current consent document versions",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentMembershipConsents"
                }
              }
            }
          },
          "503": {
            "$ref": "#/components/responses/BrowserMembershipUnavailable"
          }
        }
      }
    },
    "/api/memberships/onboarding": {
      "post": {
        "operationId": "completePlaceBrowserMembershipOnboarding",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MembershipOnboardingRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Return the existing membership through the confidential Web BFF",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MembershipOnboardingResult"
                }
              }
            }
          },
          "201": {
            "description": "Create a non-elevated membership through the confidential Web BFF",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MembershipOnboardingResult"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/OnboardingRequestInvalid"
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationRequired"
          },
          "409": {
            "$ref": "#/components/responses/MembershipConsentRequired"
          },
          "503": {
            "$ref": "#/components/responses/BrowserMembershipUnavailable"
          }
        }
      }
    },
    "/v1/me": {
      "get": {
        "operationId": "getCurrentPlaceMembership",
        "security": [
          {
            "placeBearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Safe projection of the authenticated Place membership",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentMembership"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationRequired"
          },
          "403": {
            "$ref": "#/components/responses/AccessDenied"
          }
        }
      }
    },
    "/v1/memberships/onboarding": {
      "post": {
        "operationId": "completePlaceMembershipOnboarding",
        "security": [
          {
            "placeBearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MembershipOnboardingRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Return an existing membership without changing its axes",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MembershipOnboardingResult"
                }
              }
            }
          },
          "201": {
            "description": "Create a non-elevated membership with current consent evidence",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MembershipOnboardingResult"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/OnboardingRequestInvalid"
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationRequired"
          },
          "409": {
            "$ref": "#/components/responses/MembershipConsentRequired"
          },
          "503": {
            "$ref": "#/components/responses/MembershipOnboardingUnavailable"
          }
        }
      }
    },
    "/v1/membership-consents/current": {
      "get": {
        "operationId": "getCurrentPlaceMembershipConsents",
        "security": [],
        "responses": {
          "200": {
            "description": "Return the server-selected current consent document versions",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentMembershipConsents"
                }
              }
            }
          },
          "503": {
            "$ref": "#/components/responses/MembershipOnboardingUnavailable"
          }
        }
      }
    },
    "/v1/administration/memberships/{membershipId}/authority-role": {
      "patch": {
        "operationId": "changePlaceMembershipAuthorityRole",
        "security": [
          {
            "placeBearer": []
          }
        ],
        "parameters": [
          {
            "name": "membershipId",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthorityRoleChangeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Return the audited authority-role mutation outcome",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthorityRoleChangeResult"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/AuthorityRequestInvalid"
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationRequired"
          },
          "403": {
            "$ref": "#/components/responses/AccessDenied"
          },
          "404": {
            "$ref": "#/components/responses/MembershipNotFound"
          },
          "409": {
            "$ref": "#/components/responses/AuthorityChangeRejected"
          },
          "503": {
            "$ref": "#/components/responses/AuthorityChangeUnavailable"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "placeBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "CurrentMembership": {
        "type": "object",
        "additionalProperties": false,
        "required": ["membershipId", "authorityRole", "userGrade", "productTier"],
        "properties": {
          "membershipId": { "type": "string" },
          "authorityRole": {
            "enum": ["member", "reviewer", "administrator", "owner"]
          },
          "userGrade": { "type": "string", "minLength": 1 },
          "productTier": { "type": "string", "minLength": 1 }
        }
      },
      "MembershipConsent": {
        "type": "object",
        "additionalProperties": false,
        "required": ["document", "version"],
        "properties": {
          "document": { "type": "string", "minLength": 1, "maxLength": 128 },
          "version": { "type": "string", "minLength": 1, "maxLength": 128 }
        }
      },
      "MembershipOnboardingRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["acceptedConsents"],
        "properties": {
          "acceptedConsents": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": { "$ref": "#/components/schemas/MembershipConsent" }
          }
        }
      },
      "CurrentMembershipConsents": {
        "type": "object",
        "additionalProperties": false,
        "required": ["consents"],
        "properties": {
          "consents": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": { "$ref": "#/components/schemas/MembershipConsent" }
          }
        }
      },
      "MembershipOnboardingResult": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "membershipId", "authorityRole", "userGrade", "productTier"],
        "properties": {
          "status": { "enum": ["created", "existing"] },
          "membershipId": { "type": "string" },
          "authorityRole": {
            "enum": ["member", "reviewer", "administrator", "owner"]
          },
          "userGrade": { "type": "string", "minLength": 1 },
          "productTier": { "type": "string", "minLength": 1 }
        }
      },
      "AuthorityRoleChangeRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["nextRole"],
        "properties": {
          "nextRole": {
            "enum": ["member", "reviewer", "administrator", "owner"]
          }
        }
      },
      "AuthorityRoleChangeResult": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "membershipId", "authorityRole"],
        "properties": {
          "status": { "enum": ["changed", "unchanged"] },
          "membershipId": { "type": "string", "format": "uuid" },
          "previousRole": {
            "enum": ["member", "reviewer", "administrator", "owner"]
          },
          "authorityRole": {
            "enum": ["member", "reviewer", "administrator", "owner"]
          }
        }
      },
      "Problem": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "title", "status", "code", "retryable", "correlationRef"],
        "properties": {
          "type": { "type": "string" },
          "title": { "type": "string" },
          "status": { "type": "integer" },
          "code": { "type": "string" },
          "retryable": { "type": "boolean" },
          "correlationRef": { "type": "string" }
        }
      }
    },
    "responses": {
      "AuthenticationRequired": {
        "description": "The bearer token is missing or invalid",
        "content": {
          "application/problem+json": {
            "schema": { "$ref": "#/components/schemas/Problem" }
          }
        }
      },
      "AccessDenied": {
        "description": "The principal has no Place membership or lacks access",
        "content": {
          "application/problem+json": {
            "schema": { "$ref": "#/components/schemas/Problem" }
          }
        }
      },
      "BrowserAuthRejected": {
        "description": "The one-time browser login transaction is absent, invalid, expired, or rejected",
        "content": {
          "application/problem+json": {
            "schema": { "$ref": "#/components/schemas/Problem" }
          }
        }
      },
      "BrowserAuthUnavailable": {
        "description": "The source-only browser authentication runtime is inactive or unavailable",
        "content": {
          "application/problem+json": {
            "schema": { "$ref": "#/components/schemas/Problem" }
          }
        }
      },
      "BrowserMembershipUnavailable": {
        "description": "The source-only browser membership bridge is inactive or unavailable",
        "content": {
          "application/problem+json": {
            "schema": { "$ref": "#/components/schemas/Problem" }
          }
        }
      },
      "OnboardingRequestInvalid": {
        "description": "The onboarding body is malformed, unbounded, or contains unsupported fields",
        "content": {
          "application/problem+json": {
            "schema": { "$ref": "#/components/schemas/Problem" }
          }
        }
      },
      "MembershipConsentRequired": {
        "description": "The submitted consent set does not exactly match current server policy",
        "content": {
          "application/problem+json": {
            "schema": { "$ref": "#/components/schemas/Problem" }
          }
        }
      },
      "MembershipOnboardingUnavailable": {
        "description": "Membership onboarding configuration or persistence is unavailable",
        "content": {
          "application/problem+json": {
            "schema": { "$ref": "#/components/schemas/Problem" }
          }
        }
      },
      "AuthorityRequestInvalid": {
        "description": "The membership identifier or authority-role request is invalid",
        "content": {
          "application/problem+json": {
            "schema": { "$ref": "#/components/schemas/Problem" }
          }
        }
      },
      "MembershipNotFound": {
        "description": "The target membership does not exist",
        "content": {
          "application/problem+json": {
            "schema": { "$ref": "#/components/schemas/Problem" }
          }
        }
      },
      "AuthorityChangeRejected": {
        "description": "The final owner is protected or the observed role changed concurrently",
        "content": {
          "application/problem+json": {
            "schema": { "$ref": "#/components/schemas/Problem" }
          }
        }
      },
      "AuthorityChangeUnavailable": {
        "description": "Authority-role management is temporarily unavailable",
        "content": {
          "application/problem+json": {
            "schema": { "$ref": "#/components/schemas/Problem" }
          }
        }
      }
    }
  }
}
