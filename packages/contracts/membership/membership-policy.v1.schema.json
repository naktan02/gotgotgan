{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:place:membership-policy:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "requiredConsents",
    "initialUserGrade",
    "initialProductTier"
  ],
  "properties": {
    "schemaVersion": {
      "const": "place-membership-policy.v1"
    },
    "requiredConsents": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["document", "version"],
        "properties": {
          "document": { "type": "string", "minLength": 1, "maxLength": 128 },
          "version": { "type": "string", "minLength": 1, "maxLength": 128 }
        }
      }
    },
    "initialUserGrade": { "type": "string", "minLength": 1, "maxLength": 128 },
    "initialProductTier": { "type": "string", "minLength": 1, "maxLength": 128 }
  }
}
